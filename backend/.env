# === GF Finder Backend Environment ===

# Database
DATABASE_URL=postgresql+asyncpg://gfuser:gfpass@db:5432/gffinder
DATABASE_URL_SYNC=postgresql://gfuser:gfpass@db:5432/gffinder

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-api-key-here

# Yelp Fusion API
YELP_API_KEY=your-yelp-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# JWT
JWT_SECRET_KEY=change-me-in-production
